 def total(values):
     return sum(values)


+def average(values):
+    """Return the arithmetic mean of values."""
+    return total(values) / len(values)
+
+
+def top_n(values, n):
+    """Return the n largest values, largest first."""
+    return sorted(values)[-n:]
+
+
 def clamp(value, low, high):
     return max(low, min(value, high))
